print("Welcome to AI Chatbot")

while True:
    user = input("Enter your message: ").strip().lower()

    if user == "hi":
        print("Hello!")

    elif user == "how are you":
        print("I am good. What about you?")

    elif user == "bye":
        print("GoodBye!")
        break

    else:
        print("Sorry, I can't understand. Can you repeat please?")